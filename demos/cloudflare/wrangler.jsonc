{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-test",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-01-14",
	// disable_nodejs_process_v2 needed until unenv fix lands in Pages
	// See: https://github.com/withastro/astro/issues/14511
	"compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
	// Test site: served on workers.dev only (no custom domain)
	"workers_dev": true,
	"vars": {
		"EMDASH_SITE_URL": "https://emdash-test.michael-a46.workers.dev",
	},
	// D1 Database binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-test-db",
		},
	],
	// R2 bucket for media storage
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-test-media",
		},
	],
	// Cron triggers drive general maintenance.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Observability
	"observability": {
		"enabled": true,
	},
	// Sandboxed plugins need Worker Loader (Workers Paid plan). Uncomment after upgrading:
	// "worker_loaders": [{ "binding": "LOADER" }],
}
